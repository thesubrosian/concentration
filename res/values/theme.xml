<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="surface">#f6f4ef</color>
    <color name="icon_background">#1c2824</color>

    <style name="ConcentrationTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
